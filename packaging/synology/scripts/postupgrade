#!/bin/sh
# Restore the environment file saved by preupgrade.
set -u

PKG_NAME="Cadenza"
PKG_DIR="/var/packages/${PKG_NAME}"
STAGE="${PKG_DIR}/var/upgrade-stage"

if [ -d "${STAGE}" ]; then
    mkdir -p "${PKG_DIR}/etc"
    [ -f "${STAGE}/cadenza.env" ] && cp -a "${STAGE}/cadenza.env" "${PKG_DIR}/etc/"
    rm -rf "${STAGE}"
fi

exit 0
