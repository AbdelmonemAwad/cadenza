#!/bin/sh
# Post-install setup for a standalone package.
#
# Cadenza carries its own CPython, its own Python libraries and its own
# ffmpeg/ffprobe/fpcalc. It needs no Docker, no Container Manager, no Python
# from Package Center, and no root. It runs as the unprivileged package user.
#
# This script therefore does very little: record the wizard's answers where the
# service reads them, point the DSM icon and firewall entry at the chosen port,
# and state the one permission step DSM will not let an unsigned package do for
# itself.
set -u

PKG_NAME="${SYNOPKG_PKGNAME:-Cadenza}"
PKG_DIR="/var/packages/${PKG_NAME}"
VAR_DIR="${PKG_DIR}/var"
ETC_DIR="${PKG_DIR}/etc"
ENV_FILE="${ETC_DIR}/cadenza.env"

# The account the SERVICE runs as, from conf/privilege. Deliberately not
# SYNOPKG_USERNAME: DSM sets that to the DSM user performing the install, so an
# earlier version granted permissions to the human instead of the service.
PKG_USER="cadenza"

MUSIC_PATH="${wizard_music_path:-/volume1/music}"
CONFIG_PATH="${wizard_config_path:-}"
HTTP_PORT="${wizard_http_port:-8760}"
TIMEZONE="${wizard_timezone:-UTC}"
LOCALE="${wizard_locale:-en}"

# The wizard validates these in the DSM UI, but that check is client side and a
# command-line install sets the variables directly, so they are re-checked here.
case "${MUSIC_PATH}" in
    /volume[0-9]*/?*) : ;;
    *) MUSIC_PATH="/volume1/music" ;;
esac
case "${MUSIC_PATH}" in
    *[:\"\'\`\$\\]*|*" "*|*'	'*) MUSIC_PATH="/volume1/music" ;;
esac

# Empty means "use the package's own directory", which is always writable by
# the service account and needs no permission step at all. That is the default
# precisely so a first install works with nothing to configure.
if [ -n "${CONFIG_PATH}" ]; then
    case "${CONFIG_PATH}" in
        /volume[0-9]*/?*) : ;;
        *) CONFIG_PATH="" ;;
    esac
fi
if [ -n "${CONFIG_PATH}" ]; then
    case "${CONFIG_PATH}" in
        *[:\"\'\`\$\\]*|*" "*|*'	'*) CONFIG_PATH="" ;;
    esac
fi
[ -n "${CONFIG_PATH}" ] || CONFIG_PATH="${VAR_DIR}/config"

# 1024-65535. Below 1024 needs a privilege the service does not have.
case "${HTTP_PORT}" in
    ''|*[!0-9]*) HTTP_PORT="8760" ;;
    *) [ "${HTTP_PORT}" -ge 1024 ] 2>/dev/null && [ "${HTTP_PORT}" -le 65535 ] 2>/dev/null \
           || HTTP_PORT="8760" ;;
esac
case "${LOCALE}" in
    en|ar) : ;;
    *) LOCALE="en" ;;
esac
case "${TIMEZONE}" in
    ''|*[!A-Za-z0-9_/+-]*) TIMEZONE="UTC" ;;
esac

mkdir -p "${VAR_DIR}/logs" "${VAR_DIR}/config" "${ETC_DIR}"

log_line() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "${VAR_DIR}/logs/package.log" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Point DSM's own entries at the chosen port.
# ---------------------------------------------------------------------------
apply_port() {
    _port="$1"
    _ui="${PKG_DIR}/target/ui/config"
    _sc="${PKG_DIR}/target/conf/cadenza.sc"

    # Written, not patched. Rewriting this JSON with sed produced a literal
    # 0x01 where the backreference belonged -- BusyBox, GNU and MSYS seds do
    # not agree about backreferences in a replacement -- and left DSM unable to
    # parse the shortcut. Emitting the document has no dialect to get wrong.
    if [ -d "${PKG_DIR}/target/ui" ]; then
        cat > "${_ui}.new" <<UICFG
{
    ".url": {
        "SYNO.SDS._ThirdParty.App.Cadenza": {
            "type": "url",
            "allUsers": true,
            "title": "Cadenza",
            "desc": "Curate and deduplicate your music library",
            "icon": "images/cadenza_{0}.png",
            "protocol": "http",
            "port": "${_port}",
            "url": "/",
            "urlTarget": "_syno_Cadenza",
            "allowMultiInstance": false,
            "grantPrivilege": "local"
        }
    }
}
UICFG
        if mv "${_ui}.new" "${_ui}" 2>/dev/null; then
            log_line "Desktop icon set to port ${_port}."
        else
            rm -f "${_ui}.new" 2>/dev/null || true
            log_line "WARNING: could not set the desktop icon port; it still says 8760."
        fi
    fi

    # port-config is acquired before postinst runs and the copy is skipped when
    # the destination exists, so editing the payload copy is not enough on its
    # own -- synopkghelper has to be asked to refresh the resource.
    if [ -f "${_sc}" ]; then
        sed "s|^dst\.ports=.*|dst.ports=\"${_port}/tcp\"|" "${_sc}" > "${_sc}.new" 2>/dev/null \
            && mv "${_sc}.new" "${_sc}" 2>/dev/null || rm -f "${_sc}.new" 2>/dev/null || true
    fi
    if [ -x /usr/syno/sbin/synopkghelper ]; then
        /usr/syno/sbin/synopkghelper update "${PKG_NAME}" port-config >/dev/null 2>&1 \
            && log_line "Firewall entry set to ${_port}/tcp." \
            || log_line "NOTE: if DSM's firewall is on, allow ${_port}/tcp yourself."
    else
        log_line "NOTE: if DSM's firewall is on, allow ${_port}/tcp yourself."
    fi

    # INFO's adminport is fixed when the package is built and no install-time
    # script can change it, so Package Center's Open button keeps naming 8760.
    if [ "${_port}" != "8760" ]; then
        log_line "Package Center's Open button still uses 8760 (baked in at build"
        log_line "time). Use the desktop icon, or http://<this-nas>:${_port}"
    fi
}

# ---------------------------------------------------------------------------
# What the service reads at startup.
# ---------------------------------------------------------------------------
cat > "${ENV_FILE}" <<EOF
# Written at install time from the DSM wizard's answers.
# Edit and restart the package to change any of them.
TZ=${TIMEZONE}
CADENZA_LOG_LEVEL=INFO
CADENZA_DEFAULT_LOCALE=${LOCALE}
HOST_MUSIC_PATH=${MUSIC_PATH}
HOST_QUARANTINE_PATH=${MUSIC_PATH}/.cadenza-quarantine
HOST_CONFIG_PATH=${CONFIG_PATH}

# Provider API keys belong in the app's own Settings page, not here: this file
# is plain text, while the app stores them 0600 in its config directory.
EOF
chmod 640 "${ENV_FILE}" 2>/dev/null || true

printf 'CADENZA_HTTP_PORT=%s\n' "${HTTP_PORT}" > "${ETC_DIR}/port.conf"
chmod 644 "${ETC_DIR}/port.conf" 2>/dev/null || true

apply_port "${HTTP_PORT}"

# ---------------------------------------------------------------------------
# The one step that cannot be automated.
#
# DSM will not let an unsigned package grant itself access to a shared folder.
# That is measured, not assumed: requesting root in conf/privilege -- the
# mechanism Synology's own AudioStation uses -- makes DSM refuse the package at
# upload with error 4557. There is no root anywhere in this package, and no way
# for it to set this permission itself.
# ---------------------------------------------------------------------------
log_line ""
log_line "=================================================================="
log_line " Cadenza ${HTTP_PORT} installed. One step remains, and only you can"
log_line " do it, because DSM does not let a package grant itself access to"
log_line " a shared folder."
log_line ""
log_line " Give the service account '${PKG_USER}' access to your music:"
log_line "   Control Panel -> Shared Folder -> select your music folder"
log_line "   -> Edit -> Permissions"
log_line "   -> change the dropdown to 'System internal user'"
log_line "   -> tick ${PKG_USER}   -> Save"
log_line ""
log_line " That is the same entry Plex, Emby and Radarr each already have."
log_line " Nothing here runs as root, and no password is set for you: you"
log_line " create the account yourself the first time you open Cadenza."
log_line ""
log_line " Library : ${MUSIC_PATH}"
log_line " Data    : ${CONFIG_PATH}"
log_line "           (the database, your account and your API keys. Cadenza"
log_line "            records where it put them and keeps using that folder,"
log_line "            so an update never starts you from scratch.)"
log_line " Open    : http://<this-nas>:${HTTP_PORT}"
log_line "=================================================================="
log_line ""

exit 0
