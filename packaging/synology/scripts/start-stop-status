#!/bin/sh
# =============================================================================
#  Cadenza - DSM package control script
#
#  What this package is, and what it is not.
#
#  It is NOT a launcher. Cadenza ships as a container, and on DSM 7 an unsigned
#  third-party package cannot reach the Docker daemon:
#
#    * DSM 7 refuses to install a package that requests root privileges.
#    * /var/run/docker.sock is root:root 0660 and there is no docker group for
#      the package user to join.
#
#  It IS the DSM-side half of the install: the desktop icon and the port entry
#  that open the web interface, plus a docker-compose.yml written at install
#  time with the paths, port and user the wizard collected, ready to paste into
#  Container Manager.
#
#  So `start` succeeds. The earlier version exited 1 here to be honest about
#  not launching anything, but DSM reads that as a package that failed to
#  start: it shows an error, marks the package broken and hides the icon --
#  removing the one thing this package does provide. Reporting failure for work
#  the package never claimed to do is not honesty, it is a false alarm.
#
#  Tracked in https://github.com/AbdelmonemAwad/cadenza/issues/2, which also
#  covers reworking this into a native package that runs the application itself
#  with no Docker dependency at all.
# =============================================================================
set -u

PKG_NAME="Cadenza"
PKG_DIR="/var/packages/${PKG_NAME}"
VAR_DIR="${PKG_DIR}/var"
LOG_FILE="${VAR_DIR}/logs/package.log"
COMPOSE_FILE="${VAR_DIR}/docker-compose.yml"

mkdir -p "${VAR_DIR}/logs" 2>/dev/null || true

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "${LOG_FILE}" 2>/dev/null || true; }

case "${1:-}" in
    start)
        log "Cadenza package started: desktop icon and port entry are active."
        log "The application itself runs as a Container Manager project."
        log "A compose file with your wizard settings is at:"
        log "  ${COMPOSE_FILE}"
        log "Container Manager -> Project -> Create, and point it at that file."
        exit 0
        ;;
    stop)
        log "Cadenza package stopped. A running container is unaffected;"
        log "stop it from Container Manager if that is what you meant."
        exit 0
        ;;
    status)
        # 0 = running. What this package contributes -- the portal entry -- is
        # active for as long as the package is enabled. Whether the container
        # is up is Container Manager's business, and is deliberately not
        # reported here: this script has no way to ask, and guessing would put
        # a wrong answer in Package Center.
        exit 0
        ;;
    killall)
        exit 0
        ;;
    log)
        echo "${LOG_FILE}"
        exit 0
        ;;
    *)
        echo "usage: $0 {start|stop|status|killall|log}" >&2
        exit 1
        ;;
esac
