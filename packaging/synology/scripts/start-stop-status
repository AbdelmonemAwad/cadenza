#!/bin/sh
# =============================================================================
#  Cadenza - DSM service control
#
#  This package runs the application itself. It bundles its own CPython, its
#  dependencies as wheels, and its own ffmpeg/ffprobe/fpcalc, so it needs
#  neither Docker nor anything preinstalled on the NAS. DSM's own
#  /usr/bin/python3 is 3.8 and this codebase requires 3.11 or newer, which is
#  why the interpreter travels with the package rather than being borrowed.
#
#  The previous version started nothing at all: the package could only hand the
#  user a compose file to paste into Container Manager. Docker remains a fully
#  supported way to run Cadenza -- it is now a choice, not the only option.
# =============================================================================
set -u

PKG_NAME="${SYNOPKG_PKGNAME:-Cadenza}"
PKG_DIR="/var/packages/${PKG_NAME}"
TARGET="${PKG_DIR}/target"
ETC_DIR="${PKG_DIR}/etc"
VAR_DIR="${PKG_DIR}/var"

PID_FILE="${VAR_DIR}/cadenza.pid"
LOG_FILE="${VAR_DIR}/logs/service.log"

PYTHON="${TARGET}/python/bin/python3"
APP_DIR="${TARGET}/app"

mkdir -p "${VAR_DIR}/logs" 2>/dev/null || true

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "${LOG_FILE}" 2>/dev/null || true; }

# Settings written by postinst. Sourced rather than parsed: these files are
# generated by us, live in etc/ and are not user-supplied input.
[ -f "${ETC_DIR}/cadenza.env" ] && . "${ETC_DIR}/cadenza.env"
[ -f "${ETC_DIR}/port.conf" ] && . "${ETC_DIR}/port.conf"

CADENZA_HTTP_PORT="${CADENZA_HTTP_PORT:-8760}"

export CADENZA_MUSIC_ROOT="${HOST_MUSIC_PATH:-/volume1/music}"
export CADENZA_QUARANTINE_ROOT="${HOST_QUARANTINE_PATH:-${CADENZA_MUSIC_ROOT}/.cadenza-quarantine}"
export CADENZA_CONFIG_DIR="${HOST_CONFIG_PATH:-${VAR_DIR}/config}"
export CADENZA_WWW_DIR="${TARGET}/www"
export CADENZA_LOG_LEVEL="${CADENZA_LOG_LEVEL:-INFO}"
export CADENZA_DEFAULT_LOCALE="${CADENZA_DEFAULT_LOCALE:-en}"

# The bundled tools, so the engine never depends on what happens to be on PATH.
export CADENZA_FFMPEG_BIN="${TARGET}/bin/ffmpeg"
export CADENZA_FFPROBE_BIN="${TARGET}/bin/ffprobe"
export CADENZA_FPCALC_BIN="${TARGET}/bin/fpcalc"

export PYTHONPATH="${APP_DIR}:${TARGET}/lib"
# Bundled interpreter, bundled dependencies. A stray PYTHONHOME or a user
# site-packages directory would otherwise pull in someone else's copy of a
# library and produce failures that make no sense from the logs.
export PYTHONHOME="${TARGET}/python"
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
export LD_LIBRARY_PATH="${TARGET}/python/lib:${TARGET}/ffmpeg-lib:${LD_LIBRARY_PATH:-}"

is_running() {
    [ -f "${PID_FILE}" ] || return 1
    pid=$(cat "${PID_FILE}" 2>/dev/null) || return 1
    case "${pid}" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "${pid}" 2>/dev/null
}

start_daemon() {
    if is_running; then
        log "already running (pid $(cat "${PID_FILE}"))"
        return 0
    fi
    if [ ! -x "${PYTHON}" ]; then
        log "ERROR: the bundled interpreter is missing at ${PYTHON}"
        return 1
    fi

    # Checked here so the reason is readable, rather than letting the app die
    # on its first write. This is the failure the Docker path used to hit as an
    # unexplained restart loop.
    mkdir -p "${CADENZA_CONFIG_DIR}" 2>/dev/null || true
    if [ ! -w "${CADENZA_CONFIG_DIR}" ]; then
        log "ERROR: ${CADENZA_CONFIG_DIR} is not writable by $(id -un 2>/dev/null || echo 'the package user')"
        log "Grant that account write access to the folder, then start again."
        return 1
    fi

    log "starting on port ${CADENZA_HTTP_PORT} (music=${CADENZA_MUSIC_ROOT})"
    # 0.0.0.0 because nothing proxies this -- the browser connects straight to
    # the port. One worker, because the job runner and the scheduler keep state
    # in process: a second worker would run every scheduled job twice.
    nohup "${PYTHON}" -m uvicorn app.main:app \
        --host 0.0.0.0 --port "${CADENZA_HTTP_PORT}" \
        --workers 1 --no-server-header \
        --http h11 --ws websockets --loop asyncio \
        >> "${LOG_FILE}" 2>&1 &
    echo $! > "${PID_FILE}"

    # Confirm it survived startup instead of reporting success for a process
    # that exited immediately -- DSM would show the package as running while
    # nothing was listening.
    i=0
    while [ ${i} -lt 3 ]; do
        sleep 1
        if ! is_running; then
            log "ERROR: exited during startup; see ${LOG_FILE}"
            rm -f "${PID_FILE}"
            return 1
        fi
        i=$((i + 1))
    done
    log "started (pid $(cat "${PID_FILE}"))"
    return 0
}

stop_daemon() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(cat "${PID_FILE}" 2>/dev/null)
        case "${pid}" in
            ''|*[!0-9]*) : ;;
            *)
                kill "${pid}" 2>/dev/null
                # Time to finish the operation in flight: a move or a tag write
                # killed halfway is exactly what quarantine exists to prevent.
                i=0
                while [ ${i} -lt 30 ] && kill -0 "${pid}" 2>/dev/null; do
                    sleep 1
                    i=$((i + 1))
                done
                kill -9 "${pid}" 2>/dev/null
                ;;
        esac
        rm -f "${PID_FILE}"
    fi
    log "stopped"
    return 0
}

case "${1:-}" in
    start)   start_daemon ;;
    stop)    stop_daemon ;;
    restart) stop_daemon; sleep 1; start_daemon ;;
    status)
        # 0 = running, 3 = stopped. DSM shows the package accordingly, so a
        # guess here would put a wrong answer in Package Center.
        if is_running; then exit 0; else exit 3; fi
        ;;
    killall) stop_daemon ;;
    log)     echo "${LOG_FILE}" ;;
    *)
        echo "usage: $0 {start|stop|restart|status|killall|log}" >&2
        exit 1
        ;;
esac
