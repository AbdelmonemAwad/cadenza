#!/bin/sh
# =============================================================================
#  Cadenza - DSM package control script
#
#  This package does NOT currently run the application. Cadenza ships as a
#  container, and on DSM 7 an unsigned third-party package cannot reach the
#  Docker daemon:
#
#    * DSM 7 refuses to install a package that requests root privileges.
#    * /var/run/docker.sock is root:root 0660 and there is no docker group for
#      the package user to join.
#
#  Driving Docker from here is therefore impossible without either a Synology
#  signing key or a change that would hand root-equivalent access to the
#  package user. Use Container Manager instead -- see the README.
#
#  Tracked in https://github.com/AbdelmonemAwad/cadenza/issues/2, which also
#  covers reworking this into a native package with no Docker dependency.
# =============================================================================
set -u

PKG_NAME="Cadenza"
PKG_DIR="/var/packages/${PKG_NAME}"
LOG_FILE="${PKG_DIR}/var/logs/package.log"

mkdir -p "${PKG_DIR}/var/logs" 2>/dev/null || true

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "${LOG_FILE}" 2>/dev/null || true; }

explain() {
    log "Cadenza cannot be started from Package Center."
    log "On DSM 7 a third-party package runs as an unprivileged user and cannot"
    log "reach the Docker daemon, so this package cannot launch the container."
    log ""
    log "Run it through Container Manager instead:"
    log "  1. Container Manager -> Project -> Create"
    log "  2. Use the docker-compose.yml from the project repository"
    log "  3. Adjust the volume paths and the user: line, then start the project"
    log ""
    log "See https://github.com/AbdelmonemAwad/cadenza#install"
}

case "${1:-}" in
    start)
        explain
        echo "Cadenza must be run through Container Manager. See ${LOG_FILE}." >&2
        exit 1
        ;;
    stop)
        exit 0
        ;;
    status)
        exit 3      # 3 = stopped, which is what DSM expects
        ;;
    killall)
        exit 0
        ;;
    log)
        echo "${LOG_FILE}"
        exit 0
        ;;
    *)
        echo "usage: $0 {start|stop|status|killall|log}" >&2
        exit 1
        ;;
esac
