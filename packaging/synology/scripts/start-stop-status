#!/bin/sh
# =============================================================================
#  Cadenza - DSM service control
#
#  This package runs the application itself. It bundles its own CPython, its
#  dependencies as wheels, and its own ffmpeg/ffprobe/fpcalc, so it needs
#  neither Docker nor anything preinstalled on the NAS. DSM's own
#  /usr/bin/python3 is 3.8 and this codebase requires 3.11 or newer, which is
#  why the interpreter travels with the package rather than being borrowed.
#
#  Nothing here runs as root and nothing here needs Docker. The package
#  declares no dependencies at all.
# =============================================================================
set -u

PKG_NAME="${SYNOPKG_PKGNAME:-Cadenza}"
PKG_DIR="/var/packages/${PKG_NAME}"
TARGET="${PKG_DIR}/target"
ETC_DIR="${PKG_DIR}/etc"
VAR_DIR="${PKG_DIR}/var"

PID_FILE="${VAR_DIR}/cadenza.pid"
LOG_FILE="${VAR_DIR}/logs/service.log"

# Where the database, the account and the API keys were last found. Written on
# every successful start, in two places, and read from whichever answers first.
#
# etc/ is staged by preupgrade and put back by postupgrade, which is what makes
# it survive postinst rewriting cadenza.env from the wizard's answers. But that
# staging can fail -- preupgrade gives up quietly if it cannot make its
# directory, and postupgrade only checks that the directory exists, not that
# anything landed in it. If the record were only there, a failed stage would
# lose it and the upgraded service would go looking wherever the wizard once
# pointed, find nothing, and ask for a new account.
#
# var/ is @appdata. DSM keeps it across an upgrade on its own, no staging
# involved, and postinst never writes to it. So the copy that needs no help is
# the one that is hardest to lose.
DATA_RECORD="${ETC_DIR}/data-dir.conf"
DATA_RECORD_ALT="${VAR_DIR}/data-dir.conf"

PYTHON="${TARGET}/python/bin/python3"
APP_DIR="${TARGET}/app"

mkdir -p "${VAR_DIR}/logs" 2>/dev/null || true

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "${LOG_FILE}" 2>/dev/null || true; }

# Settings written by postinst. Sourced rather than parsed: these files are
# generated by us, live in etc/ and are not user-supplied input.
#
# -r, not -f, and that distinction cost a real upgrade. `.` is a POSIX special
# built-in, so when it fails the shell exits immediately with a non-zero status
# -- there is no continuing past it and no `|| true` to hang the failure on.
# One of these files ending up owned by root, which is what happens the moment
# anyone edits it over SSH with sudo, therefore made this script exit 1 on
# every single invocation. DSM calls prestop before an upgrade, got 1, and
# abandoned the upgrade with the reason visible only in
# /var/log/packages/Cadenza.log:
#
#   Begin start-stop-status prestop
#   .../etc/cadenza.env: Permission denied
#   End start-stop-status prestop ret=[1]
#
# Testing readability first means the special built-in is never reached on a
# file that would fail, so the package keeps working on its defaults and says
# what is wrong instead of becoming unmanageable.
read_config() {
    [ -e "$1" ] || return 0
    if [ -r "$1" ]; then
        . "$1"
        return 0
    fi
    log "WARNING: $1 exists but cannot be read by $(id -un 2>/dev/null || echo cadenza)."
    log "         Continuing on defaults. Fix it with:"
    log "           sudo chown cadenza:cadenza $1"
    return 0
}

read_config "${ETC_DIR}/cadenza.env"
read_config "${ETC_DIR}/port.conf"

CADENZA_HTTP_PORT="${CADENZA_HTTP_PORT:-8760}"

export CADENZA_MUSIC_ROOT="${HOST_MUSIC_PATH:-/volume1/music}"
export CADENZA_QUARANTINE_ROOT="${HOST_QUARANTINE_PATH:-${CADENZA_MUSIC_ROOT}/.cadenza-quarantine}"
export CADENZA_WWW_DIR="${TARGET}/www"
export CADENZA_LOG_LEVEL="${CADENZA_LOG_LEVEL:-INFO}"
export CADENZA_DEFAULT_LOCALE="${CADENZA_DEFAULT_LOCALE:-en}"

# The bundled tools, so the engine never depends on what happens to be on PATH.
export CADENZA_FFMPEG_BIN="${TARGET}/bin/ffmpeg"
export CADENZA_FFPROBE_BIN="${TARGET}/bin/ffprobe"
export CADENZA_FPCALC_BIN="${TARGET}/bin/fpcalc"

export PYTHONPATH="${APP_DIR}:${TARGET}/lib"
# Bundled interpreter, bundled dependencies. A stray PYTHONHOME or a user
# site-packages directory would otherwise pull in someone else's copy of a
# library and produce failures that make no sense from the logs.
export PYTHONHOME="${TARGET}/python"
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
export LD_LIBRARY_PATH="${TARGET}/python/lib:${TARGET}/ffmpeg-lib:${LD_LIBRARY_PATH:-}"

# --------------------------------------------------------------------------
# Which directory holds the database, the account and the API keys.
#
# This used to be one line -- HOST_CONFIG_PATH, or the package directory if the
# chosen folder was not writable -- re-evaluated on every single start. That is
# a data-loss trap, and it was armed on a real install: the wizard had recorded
# /volume1/docker/cadenza, that folder was not reachable by the service account,
# so the app quietly used var/config instead and put the database and the
# account there. Nothing said so. Had the configured folder later become
# writable -- the user creates it, or ticks the service account on the share --
# the very next restart would have switched to it, found it empty, and shown
# the create-your-account screen as though every scan and every setting had
# been lost.
#
# So the directory is decided once and then remembered, in a file under etc/,
# which is what DSM keeps across an upgrade.
#
# The third branch is the one that matters most. If data was recorded somewhere
# and that somewhere cannot be reached now -- volume not mounted, permission
# withdrawn -- Cadenza refuses to start. Starting anyway would offer a fresh
# account on an empty database while the real one sat intact a directory away,
# and a user who accepts that offer starts writing into the wrong place. A
# service that will not start says what is wrong; one that starts empty does
# not.
# --------------------------------------------------------------------------
has_data() {
    [ -n "${1:-}" ] || return 1
    [ -f "$1/cadenza.db" ] || [ -f "$1/auth.json" ]
}

is_writable_dir() {
    [ -n "${1:-}" ] || return 1
    mkdir -p "$1" 2>/dev/null || true
    [ -d "$1" ] && [ -w "$1" ]
}

resolve_data_dir() {
    _configured="${HOST_CONFIG_PATH:-${VAR_DIR}/config}"
    _fallback="${VAR_DIR}/config"

    _recorded=""
    # Each record is read into a cleared variable, so an exported
    # CADENZA_DATA_DIR in the environment -- or a value left by the first file --
    # cannot stand in for a record that is missing or unreadable.
    for _rec in "${DATA_RECORD}" "${DATA_RECORD_ALT}"; do
        [ -f "${_rec}" ] || continue
        CADENZA_DATA_DIR=""
        # Written by this script, never by a user; sourcing it is safe.
        . "${_rec}" 2>/dev/null || true
        if [ -n "${CADENZA_DATA_DIR:-}" ]; then
            _recorded="${CADENZA_DATA_DIR}"
            break
        fi
    done
    CADENZA_DATA_DIR=""

    # 1. A remembered directory that still holds data wins, whatever the
    #    configured path now says.
    if has_data "${_recorded}"; then
        if is_writable_dir "${_recorded}"; then
            if [ "${_recorded}" != "${_configured}" ]; then
                log "NOTE: cadenza.env asks for ${_configured}, but your data is in"
                log "      ${_recorded} and that is where Cadenza will keep it."
                log "      To move it, stop the package, copy the contents across,"
                log "      then update ${DATA_RECORD}."
            fi
            DATA_DIR="${_recorded}"
            return 0
        fi
        log "ERROR: Cadenza will not start."
        log "  Your database and account are in ${_recorded},"
        log "  and that directory cannot be written by $(id -un 2>/dev/null || echo cadenza)."
        log "  Starting anyway would show an empty Cadenza asking you to create an"
        log "  account, as though your library had been lost. It has not been."
        log "  Check that the volume is mounted, and that the service account still"
        log "  has access to that folder, then start the package again."
        return 1
    fi

    # 2. Nothing recorded yet, or the record points at an empty directory.
    #    Prefer what was configured; fall back to the package's own directory,
    #    which the service account can always write. Falling back is safe here
    #    precisely because there is no data anywhere to lose.
    if is_writable_dir "${_configured}"; then
        DATA_DIR="${_configured}"
    else
        log "NOTE: ${_configured} is not writable by $(id -un 2>/dev/null || echo cadenza)."
        log "      Using ${_fallback}, so Cadenza starts and can tell you this."
        log "      To use the folder you chose: Control Panel -> Shared Folder"
        log "      -> Edit -> Permissions -> 'System internal user' -> tick"
        log "      $(id -un 2>/dev/null || echo cadenza) -> Save, then reinstall."
        log "      Once Cadenza has written data somewhere it stays there, so"
        log "      granting access later will not move it on its own."
        DATA_DIR="${_fallback}"
    fi

    is_writable_dir "${DATA_DIR}" || {
        log "ERROR: ${DATA_DIR} is not writable either. This should not happen --"
        log "  it is inside the package's own directory."
        return 1
    }
    return 0
}

remember_data_dir() {
    # Recorded even when it equals the configured path: what makes the next
    # start safe is that the answer is written down, not that it was surprising.
    for _rec in "${DATA_RECORD}" "${DATA_RECORD_ALT}"; do
        printf 'CADENZA_DATA_DIR=%s\n' "$1" > "${_rec}.new" 2>/dev/null \
            && mv "${_rec}.new" "${_rec}" 2>/dev/null \
            || rm -f "${_rec}.new" 2>/dev/null || true
    done
}

is_running() {
    [ -f "${PID_FILE}" ] || return 1
    pid=$(cat "${PID_FILE}" 2>/dev/null) || return 1
    case "${pid}" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "${pid}" 2>/dev/null
}

# Every process still running out of this package's directory, whatever
# started it.
#
# The PID file alone is not enough. It lives on the volume, it is gone if the
# data directory is cleared, and it says nothing about a process that outlived
# the script which recorded it -- which is exactly the case that stranded a
# running service through an uninstall.
#
# Read from /proc rather than from ps: DSM's ps and BusyBox's ps disagree about
# which flags select a full command line, and a wrong flag here would silently
# match nothing. The pattern is the package's own target path, so nothing
# outside this package can match.
package_pids() {
    for _p in /proc/[0-9]*; do
        _pid="${_p#/proc/}"
        [ "${_pid}" = "$$" ] && continue
        _cmd=""
        # read, not $(tr '\0' ' ' < ...). One fork per process, over the ~700
        # entries in /proc on an idle DS1821+, made a single scan take eight
        # seconds -- and this loop runs repeatedly. read stops at the first NUL,
        # which leaves argv[0], and argv[0] is the absolute interpreter path
        # this matches on.
        #
        # Braced with the redirection outside: when a process exits between the
        # glob and the read, it is the shell that reports the failed redirect,
        # before the inner command's own 2>/dev/null could apply. Unbraced, an
        # ordinary uninstall printed a page of "No such file or directory".
        { read -r _cmd < "${_p}/cmdline"; } 2>/dev/null
        case "${_cmd}" in
            *"${TARGET}/"*) echo "${_pid}" ;;
        esac
    done
}

start_daemon() {
    if is_running; then
        log "already running (pid $(cat "${PID_FILE}"))"
        return 0
    fi
    if [ ! -x "${PYTHON}" ]; then
        log "ERROR: the bundled interpreter is missing at ${PYTHON}"
        return 1
    fi

    _me="$(id -un 2>/dev/null || echo cadenza)"

    # Decided once and remembered, never re-derived. See resolve_data_dir.
    DATA_DIR=""
    resolve_data_dir || return 1
    export CADENZA_CONFIG_DIR="${DATA_DIR}"
    remember_data_dir "${DATA_DIR}"

    # The library is checked too, and only warned about: a library mounted
    # read-only on purpose is a supported way to evaluate Cadenza, and scanning
    # and duplicate analysis never write. Refusing to start would take that away.
    if [ ! -r "${CADENZA_MUSIC_ROOT}" ]; then
        log "WARNING: ${CADENZA_MUSIC_ROOT} cannot be read by ${_me}, so a scan"
        log "will find nothing. This is the one step that cannot be automated:"
        log "an unsigned DSM package may not grant itself access to a share."
        log "  Control Panel -> Shared Folder -> select your music folder ->"
        log "  Edit -> Permissions -> change the dropdown to 'System internal"
        log "  user' -> tick ${_me} -> Save. Then restart the package."
        log "This is the same entry Plex, Emby and Radarr each have on that share."
    fi

    log "starting on port ${CADENZA_HTTP_PORT} (music=${CADENZA_MUSIC_ROOT} data=${CADENZA_CONFIG_DIR})"
    # 0.0.0.0 because nothing proxies this -- the browser connects straight to
    # the port. One worker, because the job runner and the scheduler keep state
    # in process: a second worker would run every scheduled job twice.
    nohup "${PYTHON}" -m uvicorn app.main:app \
        --host 0.0.0.0 --port "${CADENZA_HTTP_PORT}" \
        --workers 1 --no-server-header \
        --http h11 --ws websockets --loop asyncio \
        >> "${LOG_FILE}" 2>&1 &
    echo $! > "${PID_FILE}"

    # Confirm it survived startup instead of reporting success for a process
    # that exited immediately -- DSM would show the package as running while
    # nothing was listening.
    i=0
    while [ ${i} -lt 3 ]; do
        sleep 1
        if ! is_running; then
            log "ERROR: exited during startup; see ${LOG_FILE}"
            rm -f "${PID_FILE}"
            return 1
        fi
        i=$((i + 1))
    done
    log "started (pid $(cat "${PID_FILE}"))"
    return 0
}

stop_daemon() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(cat "${PID_FILE}" 2>/dev/null)
        case "${pid}" in
            ''|*[!0-9]*) : ;;
            *)
                kill "${pid}" 2>/dev/null
                # Time to finish the operation in flight: a move or a tag write
                # killed halfway is exactly what quarantine exists to prevent.
                i=0
                while [ ${i} -lt 30 ] && kill -0 "${pid}" 2>/dev/null; do
                    sleep 1
                    i=$((i + 1))
                done
                kill -9 "${pid}" 2>/dev/null
                ;;
        esac
        rm -f "${PID_FILE}"
    fi

    # Then anything else still running out of target/. Uninstalling used to
    # leave the service alive: DSM deleted /var/packages/Cadenza while uvicorn
    # kept running from the deleted files, still bound to the port and still
    # answering /health with the version that had just been removed. Measured
    # on a DS1821+.
    remaining="$(package_pids)"
    if [ -n "${remaining}" ]; then
        log "stopping leftover processes:${remaining}"
        for pid in ${remaining}; do kill "${pid}" 2>/dev/null; done
        i=0
        while [ ${i} -lt 15 ] && [ -n "$(package_pids)" ]; do
            sleep 1
            i=$((i + 1))
        done
        for pid in $(package_pids); do kill -9 "${pid}" 2>/dev/null; done
    fi

    log "stopped"
    return 0
}

case "${1:-}" in
    start)   start_daemon ;;
    stop)    stop_daemon ;;
    restart) stop_daemon; sleep 1; start_daemon ;;
    status)
        # 0 = running, 3 = stopped. DSM shows the package accordingly, so a
        # guess here would put a wrong answer in Package Center.
        if is_running; then exit 0; else exit 3; fi
        ;;
    killall) stop_daemon ;;
    log)     echo "${LOG_FILE}" ;;

    # DSM 7 calls prestart before start, and treats a non-zero exit as a failed
    # precheck: it abandons the start, marks the package start_failed, and then
    # calls stop. This script used to answer prestart from the catch-all below,
    # printing a usage line and exiting 1 -- so DSM could never start Cadenza at
    # all, on demand or at boot. From /var/log/packages/Cadenza.log:
    #
    #   Begin start-stop-status prestart
    #   usage: ... {start|stop|restart|status|killall|log}
    #   End start-stop-status prestart ret=[1]
    #
    # The package looked healthy the whole time, because it had only ever been
    # started by hand over SSH.
    #
    # There is nothing to check here that start_daemon does not already check
    # for itself, and it reports its findings in a log the user can read rather
    # than as an exit code DSM renders as "Failed to pass precheck".
    prestart|poststart|prestop|poststop) : ;;

    *)
        # Exit 0, not 1. This script is only ever invoked by DSM, and the cost
        # of the two answers is not symmetric: a verb we do not recognise costs
        # nothing if ignored, while refusing it stops the package from running.
        # That is exactly how prestart was lost above.
        log "ignoring unrecognised argument: ${1:-}"
        ;;
esac
