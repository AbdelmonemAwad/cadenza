#!/bin/sh
# Pre-installation checks.
set -u

# 1) Architecture. This package ships an x86_64 image only.
ARCH="$(uname -m)"
case "${ARCH}" in
    x86_64|amd64) ;;
    *)
        echo "This package supports x86_64 only (DS1821+ / DVA3221). Detected: ${ARCH}" >&2
        exit 1
        ;;
esac

# 2) Container Manager (or the older Docker package) must be present.
DOCKER_FOUND=0
for candidate in /usr/local/bin/docker /usr/bin/docker \
                 /var/packages/ContainerManager/target/usr/bin/docker \
                 /var/packages/Docker/target/usr/bin/docker; do
    [ -x "${candidate}" ] && DOCKER_FOUND=1 && break
done
if [ "${DOCKER_FOUND}" -eq 0 ]; then
    echo "Install and start Container Manager (or Docker) before installing this package." >&2
    exit 1
fi

# 3) Enough free space for the image (~1.2 GB) plus the database.
AVAIL_KB="$(df -Pk /volume1 2>/dev/null | awk 'NR==2 {print $4}')"
if [ -n "${AVAIL_KB}" ] && [ "${AVAIL_KB}" -lt 2097152 ]; then
    echo "Less than 2 GB free on /volume1. Free some space and try again." >&2
    exit 1
fi

exit 0
