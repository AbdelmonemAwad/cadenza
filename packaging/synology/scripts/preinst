#!/bin/sh
# Pre-installation checks. Runs as the unprivileged package user.
set -u

# The bundled build is x86_64 only (DS1821+, DVA3221, DS920+, DS1621+ and
# similar). ARM models would need a separate build.
ARCH="$(uname -m)"
case "${ARCH}" in
    x86_64|amd64) ;;
    *)
        echo "This package supports x86_64 only. Detected: ${ARCH}" >&2
        exit 1
        ;;
esac

exit 0
