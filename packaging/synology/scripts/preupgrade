#!/bin/sh
# Preserve the generated environment file across an upgrade.
#
# Staging deliberately happens inside the package directory rather than /tmp:
# a fixed, predictable /tmp path is world-writable and lets a local user
# pre-create it as a symlink, redirecting whatever we copy.
set -u

PKG_NAME="Cadenza"
PKG_DIR="/var/packages/${PKG_NAME}"
STAGE="${PKG_DIR}/var/upgrade-stage"

rm -rf "${STAGE}"
mkdir -p "${STAGE}" || exit 0
[ -f "${PKG_DIR}/etc/cadenza.env" ] && cp -a "${PKG_DIR}/etc/cadenza.env" "${STAGE}/"
# The chosen port. target/ is wiped on upgrade, so this is what postupgrade
# uses to put the desktop icon and firewall entry back where the user set them.
[ -f "${PKG_DIR}/etc/port.conf" ] && cp -a "${PKG_DIR}/etc/port.conf" "${STAGE}/"
# Where the database and the account actually are. This is the file that makes
# an upgrade keep them: without it the new version re-derives the directory from
# cadenza.env, and if that path is not the one in use it starts on an empty
# database and asks the user to create an account again.
[ -f "${PKG_DIR}/etc/data-dir.conf" ] && cp -a "${PKG_DIR}/etc/data-dir.conf" "${STAGE}/"

exit 0
