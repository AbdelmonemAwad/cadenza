[
    {
        "step_title": "Cadenza setup - read this first",
        "items": [
            {
                "type": "textfield",
                "desc": "MUSIC LIBRARY. An existing shared folder; Cadenza reads every audio file under it. When you ask it to, it also renames, moves, retags and converts them. Nothing is ever deleted outright: removals go to a quarantine folder and can be restored for 30 days. Scanning and duplicate analysis never write anything, so you can look before granting write access.",
                "subitems": [
                    {
                        "key": "wizard_music_path",
                        "desc": "Library path",
                        "defaultValue": "/volume1/music",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^\\/volume[0-9]+\\/[^\\s:\"'`$\\\\]+$/",
                                "errorText": "Must start with /volume1/ and contain no spaces, colons or quotes — for example /volume1/music"
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "WEB PORT. The DSM desktop icon follows this. If DSM's firewall is enabled you may need to allow this port yourself under Control Panel -> Security -> Firewall; the install log says so if it could not do it for you. Package Center's own Open button always uses 8760.",
                "subitems": [
                    {
                        "key": "wizard_http_port",
                        "desc": "Port",
                        "defaultValue": "8760",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^(102[4-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$/",
                                "errorText": "Enter a port between 1024 and 65535"
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "CONFIG FOLDER for the database, logs, settings and API keys - back this up. It must already exist; create it in File Station first. The installer grants Cadenza's own service account access to it, so you do not need to set permissions yourself. Do not put it inside the music library.",
                "subitems": [
                    {
                        "key": "wizard_config_path",
                        "desc": "Config folder",
                        "defaultValue": "/volume1/docker/cadenza",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^\\/volume[0-9]+\\/[^\\s:\"'`$\\\\]+$/",
                                "errorText": "Must start with /volume1/ and contain no spaces, colons or quotes — for example /volume1/docker/cadenza"
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "TIMEZONE and LANGUAGE for the interface (English or Arabic). The DSM account below is used only if you later run Cadenza as a container instead - the package itself runs as its own service account, and the installer grants that account access to the folders above.",
                "subitems": [
                    {
                        "key": "wizard_timezone",
                        "desc": "Timezone (e.g. Europe/London, Asia/Riyadh)",
                        "defaultValue": "UTC"
                    },
                    {
                        "key": "wizard_locale",
                        "desc": "Default language: en or ar",
                        "defaultValue": "en"
                    },
                    {
                        "key": "wizard_run_user",
                        "desc": "DSM username (leave empty to use the music folder's owner)",
                        "defaultValue": ""
                    }
                ]
            }
        ]
    }
]
