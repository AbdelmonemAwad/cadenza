[
    {
        "step_title": "Cadenza setup - read this first",
        "items": [
            {
                "type": "textfield",
                "desc": "MUSIC LIBRARY. An existing shared folder; Cadenza reads every audio file under it. When you ask it to, it also renames, moves, retags and converts them. Nothing is ever deleted outright: removals go to a quarantine folder and can be restored for 30 days. Scanning and duplicate analysis never write anything, so you can look before granting write access. AFTER INSTALLING you must give Cadenza's service account access to this folder yourself - Control Panel, Shared Folder, Edit, Permissions, switch the dropdown to 'System internal user', tick 'cadenza', Save. DSM does not allow an unsigned package to grant itself access to a share, so this is the one step the installer cannot do for you. It is the same entry Plex, Emby and Radarr each have.",
                "subitems": [
                    {
                        "key": "wizard_music_path",
                        "desc": "Library path",
                        "defaultValue": "/volume1/music",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^\\/volume[0-9]+\\/[^\\s:\"'`$\\\\]+$/",
                                "errorText": "Must start with /volume1/ and contain no spaces, colons or quotes — for example /volume1/music"
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "WEB PORT. The DSM desktop icon follows this. If DSM's firewall is enabled you may need to allow this port yourself under Control Panel -> Security -> Firewall; the install log says so if it could not do it for you. Package Center's own Open button always uses 8760.",
                "subitems": [
                    {
                        "key": "wizard_http_port",
                        "desc": "Port",
                        "defaultValue": "8760",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^(102[4-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$/",
                                "errorText": "Enter a port between 1024 and 65535"
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "DATA FOLDER for the database, logs, settings and API keys. LEAVE THIS EMPTY unless you have a reason not to: Cadenza then keeps its data inside its own package folder, which its service account can always write and which DSM preserves when you update the package. If you do name a folder it must already exist, and you must grant the 'cadenza' account access to it the same way as the music folder - the installer cannot do that for you. Do not put it inside the music library. Once Cadenza has written data to a folder it keeps using that folder; changing this later does not move anything, and Cadenza will tell you so rather than start on an empty database.",
                "subitems": [
                    {
                        "key": "wizard_config_path",
                        "desc": "Data folder (leave empty for the package's own folder)",
                        "defaultValue": "",
                        "validator": {
                            "allowBlank": true,
                            "regex": {
                                "expr": "/^$|^\\/volume[0-9]+\\/[^\\s:\"'`$\\\\]+$/",
                                "errorText": "Leave empty, or give a path starting with /volume1/ containing no spaces, colons or quotes"
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "TIMEZONE and LANGUAGE for the interface (English or Arabic). Cadenza runs as its own unprivileged service account and needs no DSM user, no root and no other package. You create the Cadenza username and password yourself the first time you open it; nothing is generated and there is no default credential.",
                "subitems": [
                    {
                        "key": "wizard_timezone",
                        "desc": "Timezone (e.g. Europe/London, Asia/Riyadh)",
                        "defaultValue": "UTC"
                    },
                    {
                        "key": "wizard_locale",
                        "desc": "Default language: en or ar",
                        "defaultValue": "en"
                    }
                ]
            }
        ]
    }
]
