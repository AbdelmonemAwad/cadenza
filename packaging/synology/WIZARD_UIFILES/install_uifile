[
    {
        "step_title": "Cadenza setup",
        "items": [
            {
                "type": "textfield",
                "desc": "Path to your music library on the NAS (an existing shared folder)",
                "subitems": [
                    {
                        "key": "wizard_music_path",
                        "desc": "Library path",
                        "defaultValue": "/volume1/music",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^\\/volume[0-9]+\\/[^\\s:\"'`$\\\\]+$/",
                                "errorText": "Must start with /volume1/ and contain no spaces, colons or quotes — for example /volume1/music"
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "Port for the web interface. The DSM icon follows this port. If DSM's firewall is on, allow this port yourself under Control Panel → Security → Firewall.",
                "subitems": [
                    {
                        "key": "wizard_http_port",
                        "desc": "Port",
                        "defaultValue": "8760",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^(102[4-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$/",
                                "errorText": "Enter a port between 1024 and 65535"
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "Folder for the database, logs and settings. It must already exist and be owned by the account below — create it in File Station first. Do not use a folder inside the music library.",
                "subitems": [
                    {
                        "key": "wizard_config_path",
                        "desc": "Config folder",
                        "defaultValue": "/volume1/docker/cadenza",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^\\/volume[0-9]+\\/[^\\s:\"'`$\\\\]+$/",
                                "errorText": "Must start with /volume1/ and contain no spaces, colons or quotes — for example /volume1/docker/cadenza"
                            }
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "Timezone, interface language, and the user that will own written files",
                "subitems": [
                    {
                        "key": "wizard_timezone",
                        "desc": "Timezone (e.g. Europe/London, Asia/Riyadh)",
                        "defaultValue": "UTC"
                    },
                    {
                        "key": "wizard_locale",
                        "desc": "Default language: en or ar",
                        "defaultValue": "en"
                    },
                    {
                        "key": "wizard_run_user",
                        "desc": "DSM username (leave empty to use the music folder's owner)",
                        "defaultValue": ""
                    }
                ]
            }
        ]
    }
]
