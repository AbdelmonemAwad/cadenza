root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,json,css,html,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Shell scripts run on DSM; CRLF breaks them silently.
[*.sh]
end_of_line = lf

[Makefile]
indent_style = tab
