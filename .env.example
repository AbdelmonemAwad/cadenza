# ==== Cadenza runtime ====
CADENZA_MUSIC_ROOT=/music
CADENZA_QUARANTINE_ROOT=/quarantine
CADENZA_CONFIG_DIR=/config
CADENZA_LOG_LEVEL=INFO
CADENZA_WORKERS=4
CADENZA_HTTP_PORT=8760
CADENZA_DEFAULT_LOCALE=en

# ==== Development only — leave both of these alone on a NAS ====
# Serves the OpenAPI schema and the interactive docs, which together are a
# machine-readable map of every destructive endpoint.
CADENZA_ENABLE_DOCS=false
# Cross-origin requests allowed to carry the session cookie. Empty is correct
# for every deployment: nginx serves the UI from the same origin, and the Vite
# dev server proxies /api, so neither needs it. Exact origins only, comma
# separated, e.g. CADENZA_CORS_DEV_ORIGINS=http://localhost:5173
CADENZA_CORS_DEV_ORIGINS=

# ==== Host paths on the NAS (used by docker-compose) ====
HOST_MUSIC_PATH=/volume1/music
HOST_QUARANTINE_PATH=/volume1/music/.cadenza-quarantine
HOST_CONFIG_PATH=/volume1/docker/cadenza/config

# UID/GID the container runs as. Find yours over SSH with: id <your-dsm-user>
CADENZA_UID=1029
CADENZA_GID=100
TZ=UTC

# ==== Metadata providers (optional; can also be set in the UI) ====
# AcoustID  - free key from https://acoustid.org/new-application
ACOUSTID_API_KEY=
# Discogs   - personal access token from https://www.discogs.com/settings/developers
DISCOGS_TOKEN=
# Last.fm   - https://www.last.fm/api/account/create
LASTFM_API_KEY=
# MusicBrainz requires a contact address in the User-Agent; no key needed.
MUSICBRAINZ_CONTACT=admin@example.com

# ==== Apple Music (requires an Apple Developer Program membership) ====
# Place AuthKey_XXXXXXXXXX.p8 in the config folder and point to it here.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=/config/AuthKey.p8
APPLE_STOREFRONT=us
